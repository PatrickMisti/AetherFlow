{
  "Akka": {
    "Remote": {
      "Host": "localhost",
      "Port": 8091
    },
    "Cluster": {
      "Roles": [
        "aether-engine"
      ],
      "ServiceName": "aether-cluster",
      "RequiredContactPoints": 1,
      "SeedNodes": [
        "akka.tcp://AetherFlowCluster@localhost:8091"
      ],
      "ShardRegionRole": "aether-engine",
      "ShardRegionName": "aether-shard"
    },
    "Management": {
      "Port": 8890
    }
  },
  "AkkaDbSettings": {
    "ConnectionString": "Host=localhost;Port=5432;Database=aetherflow;Username=postgres;Password=akka",
    "ProviderName": "PostgreSQL"
  }
}